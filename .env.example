# ID của Google Sheet (đoạn giữa /d/ và /edit trong link)
GOOGLE_SHEET_ID=

# Nội dung file JSON key của service account (dán nguyên cả JSON, hoặc base64 của nó)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Chỉ dùng khi chạy trên máy: đường dẫn tới file JSON key thay cho biến ở trên
# GOOGLE_SERVICE_ACCOUNT_FILE=.secrets/service-account.json

# Mã truy cập chung cho cả nhà. Để trống = ai có link cũng vào được.
APP_PASSCODE=
